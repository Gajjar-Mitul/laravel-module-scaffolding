{
    "name": "gajjar-mitul/laravel-module-scaffolding",
    "description": "A configurable end-to-end module scaffolding package for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "module", "scaffolding", "generator", "crud"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "symfony/yaml": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "LaravelScaffolding\\Scaffolding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelScaffolding\\Scaffolding\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelScaffolding\\Scaffolding\\ScaffoldingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
